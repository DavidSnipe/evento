# Copiază în .env.local și completează din Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Opțional — pentru redirect-uri OAuth/email în producție
# NEXT_PUBLIC_SITE_URL=https://domeniul-tau.vercel.app

# Admin marketplace — emailul unic cu drepturi de /admin (plus profiles.is_admin = true)
# ADMIN_EMAIL=david@youremail.com

# Google Gemini API — scanare listă invitați din fotografie (tab Fotografie în Import)
GEMINI_API_KEY=your-gemini-api-key
